// Pikorua HRM — Prisma schema.
// Authoritative source: docs/SCHEMA.md. This is a SHARED Phase 0 file.
// Migration ownership rules apply (see docs/IMPLEMENTATION_PLAN.md §6):
// after the initial full migration, each dev only edits models in their own
// track; changes to shared tables (users, employees, departments, teams) must
// be flagged to the other dev before merge.
//
// Track tags below mark which dev primarily owns each model. All models are
// created up front in Phase 0 so the two tracks never race to add tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

// 7 confirmed roles. `bde_lead` is intentionally NOT included yet — unconfirmed
// (see docs/PRD.md §7 open questions). Add here + in lib/rbac if confirmed.
enum Role {
  admin
  hr
  tech_lead
  sales_lead
  tech_employee
  sales_employee
  bde
}

enum EmployeeStatus {
  active
  inactive
}

enum EmploymentType {
  fulltime
  parttime
  intern
}

enum WorkItemMode {
  atomic
  metric
}

enum WorkItemFrequency {
  daily
  monthly
}

// Which real-world sales number a metric WorkItem tracks (Pillar 4, 2026-08-10).
// This is the binding key between a WorkItem and the CRM feed: crm-sync writes
// each synced count into the WorkItem carrying the matching salesMetric, rather
// than guessing from the title string.
//
// It is deliberately a three-way split, not the activity/outcome two-way
// `metricTier` the plan sketched: the owner weights site visits and bookings
// differently from each other (17 vs 23 — many prospects take a visit, very few
// actually book), so a single "outcome" bucket could not express the scoring.
// The activity/outcome tier is derivable from this (calls = activity, the rest
// = outcome) — see metricTierOf() in lib/sales/metrics.ts.
enum SalesMetric {
  calls
  site_visits
  bookings
}

// How a CRM row was attributed to an employee. `unmatched` rows are retained
// (never silently dropped) so an admin can see who the feed mentions that HRM
// does not recognise — a typo'd name must never be guessed onto the wrong rep.
enum SalesMatchMethod {
  email
  name
  unmatched
}

// Offline-call claim lifecycle (2026-08-10). Reps who work a raw Excel list
// make calls the CRM never sees; they claim those, and the Lead approves.
// A claim is worth nothing until approved.
enum OfflineClaimStatus {
  pending
  approved
  rejected
}

enum WorkUnitStatus {
  active
  completed
  archived
}

// `in_review` (Pillar 2, 2026-08-08) sits between wip and completed: an atomic
// task worth more than the auto-credit threshold (WORK_ITEM_REVIEW_THRESHOLD,
// default 3 pts) lands here when the assignee marks it done, and only becomes
// `completed` — and only then credits points — when a Lead accepts it.
// Small tasks skip this state entirely and credit instantly, as before.
enum WorkItemStatus {
  pending
  wip
  in_review
  completed
}

enum AttendanceApprovalStatus {
  pending
  approved
}

// `manual` is the v1 default. device_sync / manual_import are for the
// biometric (TeamOffice) punch feed — kept so wiring the device up needs no
// reshape of attendance_records or attendance_sessions.
enum AttendanceSource {
  manual
  device_sync
  manual_import
}

// Where a clock-in happened. Work-from-home is a first-class attendance
// location (2026-08-11), not a leave request: a WFH day is a fully worked,
// fully paid day — it just never comes from the office biometric device, so
// the source stays `manual` while the location says `wfh`. The pre-existing
// RequestType.wfh is a different thing (asking permission ahead of time) and
// is left alone.
enum WorkLocation {
  office
  wfh
}

enum RequestType {
  leave_paid
  leave_unpaid
  reimbursement
  wfh
  other
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum PayslipStatus {
  draft
  finalized
}

enum RecognitionPeriodType {
  weekly
  monthly
}

enum AnnouncementScope {
  team
  all
  specific_teams
}

enum EventType {
  birthday
  anniversary
  meeting
  // Admin/HR-logged milestone tied to one employee (e.g. work anniversary
  // note, custom recognition date) — distinct from `meeting` which requires
  // invitees. Added 2026-08-07 for the employee-events feature.
  custom
}

// ===========================================================================
// 1. CORE IDENTITY & ORG STRUCTURE  (shared foundation — Phase 0)
// ===========================================================================

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               Role
  // Bumped on password change / deactivation to revoke all outstanding JWTs
  // (session.ts embeds this as the `tv` claim and rejects a mismatch).
  tokenVersion       Int       @default(0) @map("token_version")
  // True while the account still uses its onboarding temp password; the
  // dashboard layout forces a password change before anything else is usable.
  // Cleared on the first successful change-password. Default false so existing
  // and seeded accounts are never force-prompted.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  employeeId         String?   @unique @map("employee_id") @db.Uuid
  employee           Employee? @relation(fields: [employeeId], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Back-relations for audit "actor" columns.
  approvedAttendance     AttendanceRecord[]   @relation("AttendanceApprover")
  approvedRequests       Request[]            @relation("RequestApprover")
  generatedPayslips      Payslip[]            @relation("PayslipGenerator")
  notifications          Notification[]
  createdAnnouncements   Announcement[]       @relation("AnnouncementCreator")
  createdEvents          Event[]              @relation("EventCreator")
  auditLogs              AuditLog[]           @relation("AuditActor")
  createdHolidays        Holiday[]            @relation("HolidayCreator")
  pushTokens             PushToken[]
  resetTokens            PasswordResetToken[]
  revertedWeeklyOffMoves WeeklyOffMove[]      @relation("WeeklyOffMoveReverter")

  @@map("users")
}

// Forgot-password flow (2026-07-16). Raw token is emailed once and never
// stored — only its sha256 hash lives here, so a DB read can't yield a usable
// token. Single-use (`usedAt`) + short-lived (`expiresAt`, 15min, set by the
// forgot-password route).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  typeKey   String   @map("type_key") // machine key: tech / sales / bd
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teams                Team[]
  employees            Employee[]
  workUnits            WorkUnit[]
  recognitionSnapshots RecognitionSnapshot[]

  @@map("departments")
}

// Generic label mapping (PRD §4.1). Keyed by department type, not a strict FK,
// so a new department type's labels can be configured before a department row
// exists.
model DepartmentLabel {
  id                String       @id @default(uuid()) @db.Uuid
  departmentTypeKey String       @unique @map("department_type_key")
  workUnitLabel     String       @map("work_unit_label") // "Project" / "Campaign"
  subUnitLabel      String       @map("sub_unit_label") // "Feature" / "Target Segment"
  workItemLabel     String       @map("work_item_label") // "Task" / "Call"
  workItemMode      WorkItemMode @map("work_item_mode") // default progress model

  @@map("department_labels")
}

model Team {
  id                  String     @id @default(uuid()) @db.Uuid
  departmentId        String     @map("department_id") @db.Uuid
  department          Department @relation(fields: [departmentId], references: [id])
  name                String
  teamLeadId          String?    @map("team_lead_id") @db.Uuid
  teamLead            Employee?  @relation("TeamLead", fields: [teamLeadId], references: [id])
  // "HH:MM" 24h, server-local time. Admin/HR-set per team; defaults to
  // "11:00" unless explicitly customized (owner request, 2026-08-08 — team
  // creation/edit UI always sends a value now). Still nullable at the schema
  // level: null = no fixed start time configured, so late-tracking is
  // skipped for that team's attendance records (Track A decision,
  // 2026-07-13 — see docs/TRACK_A_TASKS.md) — that escape hatch stays
  // available via direct API calls even though the UI no longer offers it.
  expectedStartTime   String?    @default("11:00") @map("expected_start_time")
  // Company-default shift end (2026-08-12, owner request): 11:00-19:00 (8h)
  // is the default for every team, editable per team same as
  // expectedStartTime. Used both by the late-arrival "made it up by staying
  // late" waiver (lib/attendance/time.ts#isLateWaivedByMakeup) and as the
  // real per-team input to getDefaultClockOut's EOD auto-fill (which
  // previously assumed a hardcoded 9h workday regardless of team config).
  expectedEndTime     String?    @default("19:00") @map("expected_end_time")
  // Day of week this team is off by default (owner request, 2026-08-08).
  // 0=Sunday..6=Saturday (matches JS Date#getUTCDay()). Defaults to Sunday —
  // the old hardcoded rule in lib/attendance/monthly-breakdown.ts — but is
  // now per-team and editable in the team create/edit UI, same pattern as
  // expectedStartTime. An individual employee can self-declare a one-off
  // WeeklyOffMove to a different day for a given week without changing the
  // team's default.
  defaultWeeklyOffDay Int        @default(0) @map("default_weekly_off_day")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  members       Employee[]     @relation("TeamMembers")
  eventInvitees EventInvitee[]

  @@map("teams")
}

model Employee {
  id                     String         @id @default(uuid()) @db.Uuid
  fullName               String         @map("full_name")
  email                  String         @unique
  phone                  String?
  departmentId           String?        @map("department_id") @db.Uuid
  department             Department?    @relation(fields: [departmentId], references: [id])
  teamId                 String?        @map("team_id") @db.Uuid
  team                   Team?          @relation("TeamMembers", fields: [teamId], references: [id])
  role                   Role
  dateOfBirth            DateTime?      @map("date_of_birth") @db.Date
  dateOfJoining          DateTime       @map("date_of_joining") @db.Date
  baseSalary             Decimal        @map("base_salary") @db.Decimal(12, 2)
  // Opaque local-storage key (lib/storage/local.ts), served via
  // GET /employees/:id/photo. Nullable in the DB because pre-2026-07-15 rows
  // predate the requirement; the create API requires a photo for new hires.
  photoUrl               String?        @map("photo_url")
  // TeamOffice biometric device employee key ("Empcode", a string — 2026-08-12).
  // Not DB-unique: an unmapped Empcode must still be ingestible into
  // device_punch_raw so it can surface on the Admin mapping screen before a
  // human confirms the link; "one employee per Empcode" is an application-
  // layer check in the mapping-confirm route, not a DB constraint.
  deviceUid              String?        @map("device_uid")
  status                 EmployeeStatus @default(active)
  employmentType         EmploymentType @default(fulltime) @map("employment_type")
  requiredDaysPerWeek    Int?           @map("required_days_per_week") // 1-6 for parttime/intern; null for standard fulltime
  defaultWeeklyOffDay    Int?           @map("default_weekly_off_day") // 0=Sun..6=Sat; overrides Team.defaultWeeklyOffDay if set
  // Per-employee sales targets (2026-08-10). Null = fall back to the org-wide
  // SalesTargetConfig. Lead-set, so a senior rep can carry 150 calls/day while
  // a new joiner carries 60 without changing everyone's default.
  dailyCallTarget        Int?           @map("daily_call_target")
  monthlySiteVisitTarget Int?           @map("monthly_site_visit_target")
  monthlyBookingTarget   Int?           @map("monthly_booking_target")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                    User?
  ledTeams                Team[]                 @relation("TeamLead")
  ledWorkUnits            WorkUnit[]             @relation("WorkUnitProjectLead")
  assignedWorkItems       WorkItem[]             @relation("WorkItemAssignee")
  reviewedWorkItems       WorkItem[]             @relation("WorkItemReviewer")
  dailySelections         DailyTaskSelection[]
  pointLedger             EmployeePointLedger[]
  attendanceRecords       AttendanceRecord[]
  payslips                Payslip[]
  requests                Request[]
  recognitionSnapshots    RecognitionSnapshot[]
  performanceReviews      PerformanceReview[]    @relation("PerformanceReviewSubject")
  performanceReviewsGiven PerformanceReview[]    @relation("PerformanceReviewReviewer")
  documents               EmployeeDocument[]
  assets                  Asset[]
  eventsAbout             Event[]                @relation("EventSubject")
  eventInvitees           EventInvitee[]
  weeklyOffMoves          WeeklyOffMove[]
  salesActivitySyncs      SalesActivitySync[]
  offlineClaims           OfflineActivityClaim[] @relation("OfflineClaimSubject")
  offlineClaimsReviewed   OfflineActivityClaim[] @relation("OfflineClaimReviewer")

  @@map("employees")
}

// ===========================================================================
// 2. HIERARCHY / PROJECT-TASK TRACKING  (generic tree — Track B)
// ===========================================================================

model WorkUnit {
  id            String         @id @default(uuid()) @db.Uuid
  departmentId  String         @map("department_id") @db.Uuid
  department    Department     @relation(fields: [departmentId], references: [id])
  name          String
  // Free-text project brief. Feeds the LLM task-generator
  // (POST /work-units/:id/generate-tasks) which proposes SubUnits + WorkItems
  // from this description. Optional; null = no brief captured yet.
  description   String?
  // Renamed from teamLeadId 2026-08-07: a WorkUnit's lead can now be any
  // employee (not just a tech_lead/sales_lead role) — see lib/rbac's
  // canAssignAtOrBelow hierarchy helper. Not to be confused with the
  // unrelated, unchanged Team.teamLeadId (actual org-team leadership).
  projectLeadId String         @map("project_lead_id") @db.Uuid
  projectLead   Employee       @relation("WorkUnitProjectLead", fields: [projectLeadId], references: [id])
  status        WorkUnitStatus @default(active)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  // Soft delete — kept for audit trail (points ledger / recognition history
  // reference WorkItems underneath). Cascades to subUnits/workItems on delete.
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)

  subUnits SubUnit[]

  @@map("work_units")
}

model SubUnit {
  id         String    @id @default(uuid()) @db.Uuid
  workUnitId String    @map("work_unit_id") @db.Uuid
  workUnit   WorkUnit  @relation(fields: [workUnitId], references: [id])
  name       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  workItems WorkItem[]

  @@map("sub_units")
}

// Supports both Atomic (Tech) and Metric (Sales/BD) modes. See SCHEMA.md note:
// metric targets reset per period_month/period_year (+ period_day for a
// frequency=daily target), tracked as a new row per period rather than an
// in-place reset.
model WorkItem {
  id           String             @id @default(uuid()) @db.Uuid
  subUnitId    String             @map("sub_unit_id") @db.Uuid
  subUnit      SubUnit            @relation(fields: [subUnitId], references: [id])
  assignedTo   String             @map("assigned_to") @db.Uuid
  assignee     Employee           @relation("WorkItemAssignee", fields: [assignedTo], references: [id])
  title        String
  // Acceptance criteria / definition of done for this one item — plain text,
  // deliberately not a separately-trackable checklist table (Pillar 1, 2026-08-08).
  description  String?
  // Lead-set target date (AI may propose one at generation; the Lead confirms).
  // Date-only: a due date is a calendar day, not an instant.
  dueDate      DateTime?          @map("due_date") @db.Date
  mode         WorkItemMode
  taskPoints   Int?               @map("task_points") // required if atomic
  targetValue  Decimal?           @map("target_value") @db.Decimal(12, 2) // required if metric; editable anytime
  currentValue Decimal?           @map("current_value") @db.Decimal(12, 2) // required if metric
  frequency    WorkItemFrequency? @map("frequency") // required if metric; immutable after creation
  periodMonth  Int?               @map("period_month") // required if metric
  periodYear   Int?               @map("period_year") // required if metric
  periodDay    Int?               @map("period_day") // required if metric && frequency=daily, else null
  // Which sales number this metric item tracks, when it is CRM-fed (Pillar 4).
  // Null for every non-sales metric item (a BDE target, say) — those stay
  // manually driven exactly as before.
  salesMetric  SalesMetric?       @map("sales_metric")
  // "Repeat this daily until stopped" (2026-08-10). Applies to BOTH atomic and
  // metric items: the daily rollover cron clones the latest non-deleted row
  // forward each day. Clearing the flag or soft-deleting the newest row stops
  // the chain — no separate template concept. Metric items with
  // frequency=daily are rolled over regardless, for backwards compatibility
  // with the pre-existing behaviour.
  repeatDaily  Boolean            @default(false) @map("repeat_daily")
  status       WorkItemStatus     @default(pending)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz(6)
  // Lead review trail (Pillar 2, 2026-08-08). `submittedAt` is when the
  // assignee marked a threshold-crossing task done; the reviewed* fields are
  // stamped when the Lead accepts or sends it back. `reviewNote` is the Lead's
  // reason — required when rejecting or when crediting fewer points than
  // taskPoints. Points actually awarded live in EmployeePointLedger, not here:
  // taskPoints stays the nominal size of the task.
  submittedAt  DateTime?          @map("submitted_at") @db.Timestamptz(6)
  reviewedBy   String?            @map("reviewed_by") @db.Uuid
  reviewer     Employee?          @relation("WorkItemReviewer", fields: [reviewedBy], references: [id])
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewNote   String?            @map("review_note")
  // Self-logged ad-hoc work (2026-08-10). An employee can log a bug fix or a
  // small feature that nobody assigned them. Points are NOT chosen by the
  // employee and NOT judged by anyone: they come fixed from the picked
  // AdhocTaskType. The Lead's only job at review is "did this happen, yes/no"
  // — a question a non-technical Lead can actually answer, which is why
  // difficulty-estimation (by AI or by human) was rejected as the mechanism.
  selfLogged   Boolean            @default(false) @map("self_logged")
  adhocTypeId  String?            @map("adhoc_type_id") @db.Uuid
  adhocType    AdhocTaskType?     @relation(fields: [adhocTypeId], references: [id])
  // Soft delete — the points ledger keeps referencing this row for audit even
  // after deletion; deleted rows are just filtered out of normal operation.
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)

  dailySelections DailyTaskSelection[]
  pointLedger     EmployeePointLedger[]

  @@index([assignedTo])
  @@index([mode, periodYear, periodMonth, periodDay])
  // Backs the Lead review queue (status = in_review) — a small, hot filter.
  @@index([status])
  @@map("work_items")
}

model DailyTaskSelection {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  workItemId String   @map("work_item_id") @db.Uuid
  workItem   WorkItem @relation(fields: [workItemId], references: [id])
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([employeeId, workItemId, date])
  @@index([employeeId, date])
  @@map("daily_task_selections")
}

// Append-only ledger crediting task points on completion (Atomic/Tech only).
model EmployeePointLedger {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  workItemId String   @map("work_item_id") @db.Uuid
  workItem   WorkItem @relation(fields: [workItemId], references: [id])
  points     Int
  creditedAt DateTime @default(now()) @map("credited_at") @db.Timestamptz(6)

  // An atomic WorkItem is credited exactly once on completion. This unique
  // constraint makes a concurrent double-complete (double-click, or /complete
  // racing PATCH) fail the second insert instead of double-crediting points.
  @@unique([workItemId])
  @@index([employeeId])
  @@map("employee_point_ledger")
}

// Fixed catalogue of ad-hoc task types an employee may self-log (2026-08-10).
// The whole point is that `points` lives HERE, set once by an Admin, not on the
// individual task: the employee picks a type, never a number, so there is no
// difficulty estimate for anyone to inflate or to have to adjudicate.
model AdhocTaskType {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // "bug_fix", "small_feature", "chore"
  label     String // "Bug fix"
  points    Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workItems WorkItem[]

  @@map("adhoc_task_types")
}

// ===========================================================================
// 2b. SALES ACTIVITY  (CRM sync + offline claims — Pillars 4/5, 2026-08-10)
// ===========================================================================

// Raw landing table for the in-house CRM's per-rep-per-day activity feed
// (GET https://crm.pikoruarealty.com/api/hrm/activity). Kept as its own table
// rather than written straight into WorkItem.currentValue so that (a) an
// unmatched rep's numbers are still recorded and visible instead of vanishing,
// and (b) a re-sync is idempotent and auditable against what the CRM actually
// said.
//
// A row with all-zero counts is meaningful: the CRM emits explicit zero rows
// for a rep who did nothing that day. Absent row = no data; zero row =
// confirmed zero. Do not conflate them.
model SalesActivitySync {
  id                String           @id @default(uuid()) @db.Uuid
  // Null when the feed named someone HRM cannot resolve. The row is kept and
  // flagged (matchMethod = unmatched) rather than guessed onto a rep.
  employeeId        String?          @map("employee_id") @db.Uuid
  employee          Employee?        @relation(fields: [employeeId], references: [id])
  crmEmail          String           @map("crm_email")
  crmName           String           @map("crm_name")
  date              DateTime         @db.Date
  callsMade         Int              @default(0) @map("calls_made")
  siteVisits        Int              @default(0) @map("site_visits")
  bookingsConfirmed Int              @default(0) @map("bookings_confirmed")
  matchMethod       SalesMatchMethod @map("match_method")
  syncedAt          DateTime         @default(now()) @map("synced_at") @db.Timestamptz(6)

  // The CRM's own grain: one row per rep per day. Upsert key for re-syncs.
  @@unique([crmEmail, date])
  @@index([employeeId, date])
  @@index([matchMethod])
  @@map("sales_activity_sync")
}

// Calls a rep made from a raw Excel list that the CRM never saw (2026-08-10).
// Rep proposes, Lead approves — worth zero until approved, so self-reporting
// alone can never inflate a score. Approved claims are summed alongside the CRM
// count into the day's calls WorkItem, but stay individually visible in the
// breakdown rather than disappearing into one blended number.
model OfflineActivityClaim {
  id         String             @id @default(uuid()) @db.Uuid
  employeeId String             @map("employee_id") @db.Uuid
  employee   Employee           @relation("OfflineClaimSubject", fields: [employeeId], references: [id])
  date       DateTime           @db.Date
  calls      Int
  // The rep's justification. Required — an unexplained claim is not reviewable.
  note       String
  status     OfflineClaimStatus @default(pending)
  reviewedBy String?            @map("reviewed_by") @db.Uuid
  reviewer   Employee?          @relation("OfflineClaimReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewNote String?            @map("review_note")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // Deliberately NOT unique per (employee, date): a rejected claim must be
  // re-submittable, and a rep may log two Excel batches in one day. Approved
  // claims are summed.
  @@index([employeeId, date])
  @@index([status])
  @@map("offline_activity_claims")
}

// Org-wide default sales targets. Versioned like PayrollConfig/LeaveConfig —
// each edit inserts a new row, so a past period's attainment reproduces the
// target that was actually in force then. Per-employee overrides live on
// Employee.{dailyCallTarget,monthlySiteVisitTarget,monthlyBookingTarget}.
model SalesTargetConfig {
  id                     String   @id @default(uuid()) @db.Uuid
  dailyCallTarget        Int      @default(100) @map("daily_call_target")
  monthlySiteVisitTarget Int      @default(20) @map("monthly_site_visit_target")
  monthlyBookingTarget   Int      @default(2) @map("monthly_booking_target")
  // When true the daily rollover auto-creates each active sales employee's
  // "calls" task, so no Lead has to seed the chain and no rep has to pick a
  // task at clock-in — it is the same task every day.
  autoAssignDailyCalls   Boolean  @default(true) @map("auto_assign_daily_calls")
  effectiveFrom          DateTime @map("effective_from") @db.Date

  @@map("sales_target_config")
}

// Knobs for the composite performance score (Pillar 6). Versioned like the
// other config tables.
model PerformanceConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  // Grace period (2026-08-10): HRM runs tracking-only until an Admin flips
  // this on. Before that, tasks and attendance are recorded but no composite
  // score is published, because the first weeks' data is knowingly incomplete
  // (in-flight projects predate HRM) and scoring people on it would be wrong.
  scoringEnabled       Boolean  @default(false) @map("scoring_enabled")
  // Ceiling on how much of an employee's monthly points may come from
  // self-logged ad-hoc work, as a percentage. Stops ad-hoc logging from
  // becoming the cheapest route to a high output score.
  selfLoggedCapPercent Int      @default(30) @map("self_logged_cap_percent")
  effectiveFrom        DateTime @map("effective_from") @db.Date

  @@map("performance_config")
}

// ===========================================================================
// 3. ATTENDANCE  (Track A) — v1 manual clock-in/out + HR/Admin approval
// ===========================================================================

model AttendanceRecord {
  id               String                   @id @default(uuid()) @db.Uuid
  employeeId       String                   @map("employee_id") @db.Uuid
  employee         Employee                 @relation(fields: [employeeId], references: [id])
  date             DateTime                 @db.Date
  // The day's BOUNDS, not a single stretch of work. With re-clock-in
  // (2026-08-11) a day can be several sessions: clock_in_raw is the first
  // punch in of the day (what late-arrival is measured from) and
  // clock_out_raw the last punch out, or null while a session is open.
  // Worked time is the SUM of attendance_sessions, never out-minus-in —
  // otherwise a lunch break would be paid as work.
  clockInRaw       DateTime?                @map("clock_in_raw") @db.Timestamptz(6)
  clockOutRaw      DateTime?                @map("clock_out_raw") @db.Timestamptz(6)
  clockInApproved  DateTime?                @map("clock_in_approved") @db.Timestamptz(6)
  clockOutApproved DateTime?                @map("clock_out_approved") @db.Timestamptz(6)
  totalHours       Decimal?                 @map("total_hours") @db.Decimal(4, 2)
  isHalfDay        Boolean                  @default(false) @map("is_half_day")
  // Manual admin override (2026-08-07): marks an otherwise-normal present
  // day as a compensation day (e.g. an employee came in to make up for a
  // leave taken elsewhere), independent of the automatic Sunday-clock-in
  // detection in lib/attendance/monthly-breakdown.ts. Both paths feed the
  // same `compensationDays` bucket — this just adds a second, manual way to
  // land in it for a weekday that isn't otherwise a day off.
  isCompensation   Boolean                  @default(false) @map("is_compensation")
  // Manual late-deduction waiver (2026-08-12, owner request): for cases where
  // a late clock-in wasn't the employee's fault (e.g. office inaccessible,
  // key not available) and they shouldn't have to "make up" the lost time by
  // staying late to avoid the deduction. Distinct from the automatic
  // isLateWaivedByMakeup waiver in lib/attendance/time.ts, which only waives
  // when the employee's own clock-out compensates for their late arrival —
  // this is Admin/HR's explicit override when neither lateness nor make-up
  // is the employee's responsibility. Set via PATCH .../edit, audited.
  lateExempt       Boolean                  @default(false) @map("late_exempt")
  lateExemptReason String?                  @map("late_exempt_reason")
  approvalStatus   AttendanceApprovalStatus @default(pending) @map("approval_status")
  approvedById     String?                  @map("approved_by") @db.Uuid // must be admin/hr
  approvedBy       User?                    @relation("AttendanceApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?                @map("approved_at") @db.Timestamptz(6)
  source           AttendanceSource         @default(manual)
  // The day's location, taken from the FIRST session of the day. Per-session
  // location is the authoritative value (someone can come in after a WFH
  // morning); this copy exists so attendance lists and filters don't have to
  // join sessions to answer "was this a WFH day?".
  workLocation     WorkLocation             @default(office) @map("work_location")
  sessions         AttendanceSession[]
  // Device-sync review flag (2026-08-12): the biometric feed gives no IN/OUT
  // flag, only a position-based guess (odd=in, even=out — see reconcile.ts).
  // A lone device punch left open at end-of-day is genuinely ambiguous: it
  // could be a real forgotten clock-out, or it could be the day's actual
  // clock-out misread as an "in" because the real clock-in punch never
  // happened (a missed badge). The EOD cleanup cron flags the latter case
  // (heuristic: a solo punch implausibly late for a first arrival) rather
  // than guessing and fabricating totalHours — Admin/HR resolve it via the
  // existing PATCH .../edit, which clears the flag.
  flaggedForReview Boolean                  @default(false) @map("flagged_for_review")
  flagReason       String?                  @map("flag_reason")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, date])
  @@index([approvalStatus])
  @@map("attendance_records")
}

// One continuous stretch of clocked-in time (2026-08-11). Added because
// clock-out used to be terminal for the day: an employee who stepped out at
// lunch could not come back, and the alternative — reopening the single
// clock_out_raw — would have paid the break as work and destroyed the day's
// first-in time that late-arrival depends on.
//
// Invariants (enforced by the clock-in/clock-out routes, not the DB):
//  - at most ONE session per record has clock_out = null (the open one);
//  - sessions never overlap, and run in chronological order;
//  - record.total_hours = sum of closed sessions (see lib/attendance/sessions).
// This is also the shape the TeamOffice biometric feed needs: every punch
// opens or closes a session, so a device day and a manual day are the same
// object.
model AttendanceSession {
  id           String           @id @default(uuid()) @db.Uuid
  recordId     String           @map("attendance_record_id") @db.Uuid
  record       AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  clockIn      DateTime         @map("clock_in") @db.Timestamptz(6)
  clockOut     DateTime?        @map("clock_out") @db.Timestamptz(6)
  source       AttendanceSource @default(manual)
  workLocation WorkLocation     @default(office) @map("work_location")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rawPunches   DevicePunchRaw[]

  @@index([recordId])
  @@map("attendance_sessions")
}

// Per-employee weekly-off override (owner request, 2026-08-08). Each team has
// a default off day (Team.defaultWeeklyOffDay, Sunday unless customized); an
// employee can self-declare ONE day off per week that differs from the
// team's default (e.g. team is off Sunday, one person needs Wednesday off
// that week instead) via POST /attendance/weekly-off — only while not yet
// clocked in that day, and only once per week (unique on
// employeeId+weekStart; claiming again the same week overwrites the pending
// date). While `active`, that date gets the same treatment Sunday already
// gets in lib/attendance/monthly-breakdown.ts (skipped as a working day;
// clocking in anyway auto-lands it in compensationDays) — and the team's
// default day-of-week is NOT treated as off for that employee that week.
// Admin/HR can revert a move (POST .../:id/revert) to fall back to the
// team's default for that week — this is also how a claimed day that the
// employee ends up clocking in on gets reclassified as a normal present day
// instead of a compensation day: revert first, then the clock-in just falls
// into normal present/half-day classification.
model WeeklyOffMove {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  employee     Employee  @relation(fields: [employeeId], references: [id])
  weekStart    DateTime  @map("week_start") @db.Date // Monday of the ISO week this applies to
  date         DateTime  @db.Date // the day now serving as this employee's off day that week
  active       Boolean   @default(true)
  revertedById String?   @map("reverted_by") @db.Uuid
  revertedBy   User?     @relation("WeeklyOffMoveReverter", fields: [revertedById], references: [id])
  revertedAt   DateTime? @map("reverted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([employeeId, weekStart])
  @@map("weekly_off_moves")
}

// TeamOffice biometric integration (2026-08-12). The vendor's incremental
// polling endpoint (DownloadLastPunchData) has no reliable IN/OUT flag, so a
// punch lands as `unknown` at ingest — reconcile.ts infers direction by
// pairing consecutive same-day punches per employee (odd = in, even = out).
enum PunchDirection {
  in
  out
  unknown
}

// Raw ingest of every TeamOffice punch, kept even after reconciliation
// (audit trail + replay safety). `dedupKey` makes re-ingesting idempotent via
// createMany({ skipDuplicates: true }) even after a partial sync failure.
model DevicePunchRaw {
  id                  String             @id @default(uuid()) @db.Uuid
  deviceUid           String             @map("device_uid")
  punchTime           DateTime           @map("punch_time") @db.Timestamptz(6)
  direction           PunchDirection     @default(unknown)
  machineId           String?            @map("machine_id")
  dedupKey            String             @unique @map("dedup_key")
  syncedAt            DateTime           @default(now()) @map("synced_at") @db.Timestamptz(6)
  reconciledAt        DateTime?          @map("reconciled_at") @db.Timestamptz(6)
  reconciledSessionId String?            @map("reconciled_session_id") @db.Uuid
  reconciledSession   AttendanceSession? @relation(fields: [reconciledSessionId], references: [id])

  @@index([deviceUid, punchTime])
  @@index([reconciledAt])
  @@map("device_punch_raw")
}

// Cursor for the incremental DownloadLastPunchData poll (LastRecord/MaxRecord,
// format MMyyyy$ID per the vendor doc). Kept as an ordinary table rather than
// a fixed-id singleton — no precedent for that pattern elsewhere in this
// schema — the sync job resolves it via findFirst and creates the one row on
// first run.
model DeviceSyncCursor {
  id         String   @id @default(uuid()) @db.Uuid
  lastRecord String?  @map("last_record")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("device_sync_cursor")
}

// ===========================================================================
// 4. PAYROLL  (Track A)
// ===========================================================================

model PayrollConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  // % of a day's pay (base_salary / 30) deducted per late-arrival occurrence
  // (2026-07-17 — replaced the old flat rupee amount). Half-day (50%) and
  // unpaid-leave/absent (100%) are no longer separately configurable here —
  // they're fixed fractions of a day's pay, derived directly from
  // base_salary, not a policy knob (see lib/payroll/calc.ts).
  lateDeductionPercent Decimal  @map("late_deduction_percent") @db.Decimal(5, 2)
  // Grace window (minutes) after a team's expected_start_time within which a
  // clock-in is NOT counted late (2026-07-17). 0 = exact-to-the-minute, the
  // prior behaviour. Snapshotted per effective_from like the deduction rate,
  // so past payslips reproduce the grace that was in force.
  lateGraceMinutes     Int      @default(0) @map("late_grace_minutes")
  effectiveFrom        DateTime @map("effective_from") @db.Date

  @@map("payroll_config")
}

// Admin-configurable paid-leave allowance (2026-08-07). Versioned like
// PayrollConfig — each edit inserts a new row rather than overwriting, so a
// balance computed for a past period reflects the allowance that was
// actually in force then, not whatever the admin later changed it to.
model LeaveConfig {
  id                         String   @id @default(uuid()) @db.Uuid
  paidLeavesPerMonth         Int      @map("paid_leaves_per_month")
  paidLeavesPerYear          Int      @map("paid_leaves_per_year")
  partTimePaidLeavesPerMonth Int      @default(0) @map("part_time_paid_leaves_per_month")
  partTimePaidLeavesPerYear  Int      @default(0) @map("part_time_paid_leaves_per_year")
  internPaidLeavesPerMonth   Int      @default(0) @map("intern_paid_leaves_per_month")
  internPaidLeavesPerYear    Int      @default(0) @map("intern_paid_leaves_per_year")
  effectiveFrom              DateTime @map("effective_from") @db.Date

  @@map("leave_config")
}

model Payslip {
  id                   String        @id @default(uuid()) @db.Uuid
  employeeId           String        @map("employee_id") @db.Uuid
  employee             Employee      @relation(fields: [employeeId], references: [id])
  periodMonth          Int           @map("period_month")
  periodYear           Int           @map("period_year")
  baseSalary           Decimal       @map("base_salary") @db.Decimal(12, 2)
  incentiveAmount      Decimal       @default(0) @map("incentive_amount") @db.Decimal(12, 2)
  bonusAmount          Decimal       @default(0) @map("bonus_amount") @db.Decimal(12, 2)
  bonusReason          String?       @map("bonus_reason")
  otherAdditionAmount  Decimal?      @map("other_addition_amount") @db.Decimal(12, 2)
  otherAdditionReason  String?       @map("other_addition_reason")
  otherDeductionAmount Decimal?      @map("other_deduction_amount") @db.Decimal(12, 2)
  otherDeductionReason String?       @map("other_deduction_reason")
  lateCount            Int           @default(0) @map("late_count") // from approved attendance only
  unpaidLeaveCount     Int           @default(0) @map("unpaid_leave_count")
  halfDayCount         Int           @default(0) @map("half_day_count")
  absentCount          Int           @default(0) @map("absent_count") // added 2026-07-17
  // Added 2026-07-17 (earned-pay proration): every count that feeds
  // earned_base_pay, stored for audit reproducibility alongside the counts
  // above. Present/half-day/paid-leave/holiday/compensation days are paid;
  // unpaid-leave/absent days are simply excluded (no separate deduction).
  presentCount         Int           @default(0) @map("present_count")
  paidLeaveCount       Int           @default(0) @map("paid_leave_count")
  holidayCount         Int           @default(0) @map("holiday_count")
  compensationCount    Int           @default(0) @map("compensation_count")
  // earned_base_pay = (present + half*0.5 + paid_leave + holiday + compensation) * per_day_rate
  earnedBasePay        Decimal       @default(0) @map("earned_base_pay") @db.Decimal(12, 2)
  // Renamed from standard_deduction_total (2026-07-17): now represents ONLY
  // the late-arrival penalty (late_count * late_deduction_percent% *
  // per_day_rate) — half-day/unpaid-leave/absent no longer separately
  // deduct, they're excluded from earned_base_pay instead.
  lateDeductionTotal   Decimal       @default(0) @map("late_deduction_total") @db.Decimal(12, 2)
  reimbursementTotal   Decimal       @default(0) @map("reimbursement_total") @db.Decimal(12, 2)
  employeeOfMonthRef   Boolean       @default(false) @map("employee_of_month_ref") // reference only
  netPay               Decimal       @map("net_pay") @db.Decimal(12, 2)
  generatedById        String        @map("generated_by") @db.Uuid // must be admin/hr
  generatedBy          User          @relation("PayslipGenerator", fields: [generatedById], references: [id])
  generatedAt          DateTime      @default(now()) @map("generated_at") @db.Timestamptz(6)
  status               PayslipStatus @default(draft)

  @@unique([employeeId, periodYear, periodMonth])
  @@map("payslips")
}

// ===========================================================================
// 5. REQUESTS  (generic — Track B)
// ===========================================================================

model Request {
  id            String        @id @default(uuid()) @db.Uuid
  employeeId    String        @map("employee_id") @db.Uuid
  employee      Employee      @relation(fields: [employeeId], references: [id])
  type          RequestType
  status        RequestStatus @default(pending)
  dateFrom      DateTime?     @map("date_from") @db.Date
  dateTo        DateTime?     @map("date_to") @db.Date
  amount        Decimal?      @db.Decimal(12, 2) // for reimbursement
  description   String?
  attachmentUrl String?       @map("attachment_url")
  approverId    String?       @map("approver_id") @db.Uuid // MUST be admin/hr (enforce in app logic)
  approver      User?         @relation("RequestApprover", fields: [approverId], references: [id])
  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([type, status])
  @@map("requests")
}

// ===========================================================================
// 6. RECOGNITION, NOTIFICATIONS, ANNOUNCEMENTS, DOCS, EVENTS, ASSETS (Track B)
// ===========================================================================

model RecognitionSnapshot {
  id                String                @id @default(uuid()) @db.Uuid
  periodType        RecognitionPeriodType @map("period_type")
  periodStart       DateTime              @map("period_start") @db.Date
  departmentId      String                @map("department_id") @db.Uuid
  department        Department            @relation(fields: [departmentId], references: [id])
  employeeId        String                @map("employee_id") @db.Uuid
  employee          Employee              @relation(fields: [employeeId], references: [id])
  score             Decimal               @db.Decimal(14, 2)
  // Pillar 6 (2026-08-08): for MONTHLY snapshots `score` is now a 0-100
  // composite (see lib/performance/composite.ts) and `components` stores the
  // weighted breakdown that produced it, so a score is always explainable
  // after the fact even if the inputs later change. Null on weekly snapshots
  // (still raw single-signal scoring) and on pre-Pillar-6 rows.
  components        Json?
  rank              Int
  isEmployeeOfMonth Boolean               @default(false) @map("is_employee_of_month")
  // 2026-08-07: auto-computation no longer sets isEmployeeOfMonth on its own
  // (see lib/cron/recognition.ts) — it's now Admin-only, via POST
  // /recognition/publish. selectedManually distinguishes an admin pick from
  // legacy/pre-migration rows; publishedAt drives the ~24h dashboard banner
  // window (GET /recognition/published).
  selectedManually  Boolean               @default(false) @map("selected_manually")
  publishedAt       DateTime?             @map("published_at") @db.Timestamptz(6)

  @@index([periodType, periodStart, departmentId])
  @@index([isEmployeeOfMonth, publishedAt])
  @@map("recognition_snapshots")
}

// Monthly, Lead-entered quality review (Pillar 3, 2026-08-08). The deliberately
// human counterweight to the automatic, countable signals (points, attendance,
// metric attainment): one 1-5 rating plus an optional note, per employee per
// month, written by the Lead who actually works with them.
//
// Scope is intentionally tiny — no goals table, no self-assessment, no
// employee-facing workflow. The employee sees it only as a read-only entry on
// their own profile if they go looking. Rows are per (employee, reviewer,
// period) so an Admin/HR review never overwrites the owning Lead's, and vice
// versa; a second attempt at the same triple is a 409 (mirrors the
// period-uniqueness pattern on RecognitionSnapshot/Payslip). Corrections go
// through PATCH /performance-reviews/:id rather than a duplicate insert.
model PerformanceReview {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  employee    Employee @relation("PerformanceReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId  String   @map("reviewer_id") @db.Uuid
  reviewer    Employee @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id])
  periodYear  Int      @map("period_year")
  periodMonth Int      @map("period_month") // 1-12
  rating      Int // 1-5, validated in lib/performance/review.ts
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, reviewerId, periodYear, periodMonth])
  @@index([employeeId, periodYear, periodMonth])
  @@index([reviewerId, periodYear, periodMonth])
  @@map("performance_reviews")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  type      String // e.g. leave_approved, task_assigned, birthday
  // Optional headline, rendered above `message` in the UI and used as the FCM
  // push title. Nullable: most notification types are a single sentence and
  // fall back to a humanized `type` for display. Announcements set it to the
  // announcement title so the (potentially long) body stays a separate block.
  title     String?
  message   String
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, readAt])
  @@map("notifications")
}

// FCM web-push device tokens (added 2026-07-15). A user can have multiple
// registered browsers/devices, so this is one-to-many, not a column on User.
// `pushNotification()` (lib/notifications/push.ts) sends to every token for
// the target user after writing the in-app Notification row — push is an
// additional delivery channel for the same event, not a parallel system.
// Registration/unregistration is self-only (POST/DELETE
// /api/v1/notifications/push-token); a token that FCM reports as
// invalid/unregistered is deleted lazily on next send failure.
model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("push_tokens")
}

model Announcement {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  body        String
  scopeType   AnnouncementScope @map("scope_type")
  teamIds     String[]          @map("team_ids") @db.Uuid // set for specific_teams; single value for team
  createdById String            @map("created_by") @db.Uuid
  createdBy   User              @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("announcements")
}

// Covers system-generated (birthday/anniversary) and manual (meeting) events.
// Birthday/anniversary may be handled as a derived query instead of persisted
// rows (see SCHEMA.md note) — table kept for optional historical logging.
model Event {
  id                  String    @id @default(uuid()) @db.Uuid
  type                EventType
  title               String?
  createdById         String?   @map("created_by") @db.Uuid // meetings: admin/hr/lead; null for system
  createdBy           User?     @relation("EventCreator", fields: [createdById], references: [id])
  scheduledAt         DateTime? @map("scheduled_at") @db.Timestamptz(6)
  reminderLeadMinutes Int?      @map("reminder_lead_minutes")
  employeeId          String?   @map("employee_id") @db.Uuid // birthday/anniversary subject
  employee            Employee? @relation("EventSubject", fields: [employeeId], references: [id])
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  invitees EventInvitee[]

  @@map("events")
}

model EventInvitee {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employeeId String?   @map("employee_id") @db.Uuid // individual invitee
  employee   Employee? @relation(fields: [employeeId], references: [id])
  teamId     String?   @map("team_id") @db.Uuid // whole-team invite, expanded at send-time
  team       Team?     @relation(fields: [teamId], references: [id])

  @@index([eventId])
  @@map("event_invitees")
}

model EmployeeDocument {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  docType    String   @map("doc_type") // "ID Proof", "Offer Letter", ...
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@map("employee_documents")
}

// Append-only audit trail for sensitive/financial mutations (payslips,
// payroll config, attendance edits/approvals, request approvals, employee
// CRUD, auth events). Written via `audit()` from @/lib/audit — rows are never
// updated or deleted, and a failed audit write never blocks the mutation.
// `actorUserId` is null for unauthenticated events (e.g. failed logins).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  actorRole   Role?    @map("actor_role")
  action      String // dotted verb, e.g. "payslip.generate", "auth.login_failed"
  entityType  String?  @map("entity_type") // e.g. "payslip", "employee"
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Company holidays, managed by Admin/HR (added 2026-07-15). One row per
// calendar date; surfaced on the /calendar page and in the attendance
// overview (a holiday date suppresses "absent" counting). Not wired into
// payroll deductions — deduction math stays attendance/leave-driven per PRD.
model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @unique @db.Date
  name        String
  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("HolidayCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("holidays")
}

// Stub only — not built out in v1 (PRD §5.12).
model Asset {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  assignedTo String?   @map("assigned_to") @db.Uuid
  employee   Employee? @relation(fields: [assignedTo], references: [id])
  status     String?

  @@map("assets")
}
